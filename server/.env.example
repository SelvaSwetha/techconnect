# Copy to .env and fill in. Never commit .env. Variables are read at startup (node --env-file).

# --- Server ---
PORT=4000
# Browser origin(s) allowed to call the API (comma separated). Leave empty when the frontend uses the Vite /api proxy or the same origin.
CORS_ORIGINS=
# Where enquiries are recorded (JSON Lines). Defaults to ./data/enquiries.jsonl
ENQUIRY_STORE_FILE=
# Private folder for uploaded job descriptions (never served over HTTP). Defaults to ./data/uploads
UPLOAD_DIR=
# Forms allowed to send enquiries (comma-separated: home, industries, employer-enquiry). Default: industries,employer-enquiry
ENQUIRY_FORMS_ENABLED=
# Set to 1 only when running behind a reverse proxy so rate limiting sees the real client IP
TRUST_PROXY=

# --- SMTP (required for email; without these the API answers 503 and sends nothing) ---
SMTP_HOST=
SMTP_PORT=
# "true" for implicit TLS (usually port 465); leave empty/false for STARTTLS (587)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown on both emails, e.g. TechzConnect <no-reply@your-domain.com> (must be allowed by your SMTP provider)
MAIL_FROM=
# The ONE internal recipient of the enquiry notification (HR / company inbox). Users can never choose this.
HIRING_ENQUIRY_TO=

# --- Optional branding ---
# Public https URL of the logo PNG shown in the email header. If empty, a text wordmark is used.
MAIL_LOGO_URL=
